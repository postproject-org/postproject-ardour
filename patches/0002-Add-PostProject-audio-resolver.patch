diff --git a/gtk2_ardour/postproject_resolver.cc b/gtk2_ardour/postproject_resolver.cc
new file mode 100644
index 0000000..73940cc
--- /dev/null
+++ b/gtk2_ardour/postproject_resolver.cc
@@ -0,0 +1,156 @@
+// SPDX-FileCopyrightText: 2026 Erich Seifert <dev@erichseifert.de>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "postproject_resolver.h"
+
+#include <postproject/postproject.hpp>
+
+#include <algorithm>
+#include <filesystem>
+#include <stdexcept>
+#include <string_view>
+
+namespace {
+
+constexpr std::string_view source_id_scheme = "org.ardour:source_id";
+
+postproject::RevisionContext origin (const std::string& message)
+{
+	return {{postproject::OriginIdentity {"org.ardour", std::nullopt, std::nullopt}}, message};
+}
+
+template <typename Reader>
+postproject::Resource single_audio_resource (const Reader& production, const postproject::AssetId& asset_id)
+{
+	const auto page = production.representations (asset_id, 1000).value ();
+	if (page.next_cursor) {
+		throw postproject::Exception (postproject::Error (postproject::ErrorCode::unsupported,
+		                                               "audio representation decision exceeds 1000 entries"));
+	}
+	std::optional<postproject::Resource> selected;
+	for (const auto& representation : page.items) {
+		if (representation.kind == postproject::RepresentationKind::original &&
+		    representation.structureKind() == postproject::ContentStructureKind::single_resource &&
+		    representation.resources.size () == 1) {
+			if (selected) {
+				throw postproject::Exception (postproject::Error (postproject::ErrorCode::ambiguous_resolution,
+				                                               "audio asset has several single-file originals"));
+			}
+			selected = representation.resources.front ();
+		}
+	}
+	if (selected) {
+		return *selected;
+	}
+	throw std::runtime_error ("PostProject asset has no single-file original representation");
+}
+
+template <typename Reader>
+std::optional<postproject::AssetId> asset_for_source_id (const Reader& production, const std::string& source_id)
+{
+	const auto matches = production.findByExternalIdentifier (source_id_scheme, source_id).value ();
+	if (matches.empty ()) {
+		return std::nullopt;
+	}
+	if (matches.size () != 1 || matches.front ().kind () != postproject::ObjectKind::asset) {
+		throw std::runtime_error ("Ardour source identifier is ambiguous");
+	}
+	return matches.front ().assetId ().value ();
+}
+
+} // namespace
+
+namespace ArdourPostProject {
+
+void
+record_source (const std::string& production_path, const std::string& source_id, const std::string& source_path)
+{
+	auto production = postproject::Production::open (production_path).value ();
+	auto view = production.readSession ().value ();
+	const postproject::ExternalIdentifier identifier {std::string (source_id_scheme), source_id, std::nullopt};
+	const auto bound_asset = asset_for_source_id (view, source_id);
+
+	if (bound_asset) {
+		const auto resource = single_audio_resource (view, *bound_asset);
+		const auto resource_id = resource.id;
+		auto transaction = view.edit (origin ("Record Ardour audio source")).value ();
+		const auto uri = postproject::fileLocator (source_path).value ();
+		if (std::none_of (resource.locators.begin (), resource.locators.end (),
+		                  [&uri] (const auto& locator) { return locator.uri == uri; })) {
+			transaction.confirmLocator (resource_id, uri).value ();
+		}
+		transaction.observeResourceContent (resource_id, source_path).value ();
+		transaction.commit ().value ();
+		return;
+	}
+
+	const auto known = view.findKnownMedia (std::filesystem::path (source_path), 2).value ();
+	if (known.next_cursor || known.items.size () > 1) {
+		throw std::runtime_error ("audio source locator identifies several PostProject assets");
+	}
+
+	auto transaction = view.edit (origin ("Record Ardour audio source")).value ();
+	postproject::AssetId asset_id = known.items.empty ()
+	                                ? transaction.importMedia (source_path, std::filesystem::path (source_path).filename ().string ()).value ().asset_id
+	                                : known.items.front ().asset_id;
+	transaction.addExternalIdentifier (postproject::ObjectRef::asset (asset_id), identifier).value ();
+	transaction.commit ().value ();
+}
+
+std::optional<std::string>
+resolve_missing_source (const std::string& production_path,
+                        const std::string& source_id,
+                        const std::vector<std::string>& search_directories)
+{
+	auto production = postproject::Production::open (production_path).value ();
+	auto view = production.readSession ().value ();
+	const auto asset_id = asset_for_source_id (view, source_id);
+	if (!asset_id) {
+		return std::nullopt;
+	}
+	const auto resource_id = single_audio_resource (view, *asset_id).id;
+
+	postproject::ResolutionConfig config;
+	std::vector<std::string> unique_directories;
+	for (const auto& directory : search_directories) {
+		if (!directory.empty () && std::find (unique_directories.begin (), unique_directories.end (), directory) == unique_directories.end ()) {
+			unique_directories.push_back (directory);
+			config.search_directories.emplace_back (directory);
+		}
+	}
+	config.verification = postproject::VerificationMode::content;
+	auto options = postproject::ResolutionOptions::create(config).value();
+
+	const auto resolutions = view.resolveAsset (*asset_id, options).value ();
+	for (const auto& representation : resolutions) {
+		const auto selected = representation.selectVerified ();
+		if (selected.has_value () && selected->locations.size () == 1 &&
+		    selected->locations.front ().resource_id == resource_id) {
+			return postproject::locatorFilePath (selected->locations.front ().candidate.uri).value ();
+		}
+		// Preserve reuse of an address another host already recorded. Samples
+		// validate that known address, but never certify newly discovered audio.
+		for (const auto& resource : representation.resources) {
+			if (resource.resource_id != resource_id || resource.state () != postproject::ResourceResolutionState::online_at_known_locator ||
+			    representation.availability != postproject::RepresentationAvailability::online || resource.candidates ().size () != 1) {
+				continue;
+			}
+			const auto blocked = [] (const auto& evidence) {
+				return evidence.kind == postproject::EvidenceKind::search_truncated || evidence.kind == postproject::EvidenceKind::discovery_error ||
+				       evidence.kind == postproject::EvidenceKind::fingerprint_not_verified || evidence.kind == postproject::EvidenceKind::fingerprint_mismatch ||
+				       evidence.kind == postproject::EvidenceKind::conflicting_candidate;
+			};
+			const auto& candidate = resource.candidates ().front ();
+			const bool sampled = std::any_of (candidate.evidence.begin (), candidate.evidence.end (), [] (const auto& evidence) {
+				return evidence.kind == postproject::EvidenceKind::partial_fingerprint_match;
+			});
+			if (sampled && !std::any_of (resource.evidence.begin (), resource.evidence.end (), blocked) &&
+			    !std::any_of (candidate.evidence.begin (), candidate.evidence.end (), blocked)) {
+				return postproject::locatorFilePath (candidate.uri).value ();
+			}
+		}
+	}
+	return std::nullopt;
+}
+
+} // namespace ArdourPostProject
diff --git a/gtk2_ardour/postproject_resolver.h b/gtk2_ardour/postproject_resolver.h
new file mode 100644
index 0000000..4df210d
--- /dev/null
+++ b/gtk2_ardour/postproject_resolver.h
@@ -0,0 +1,18 @@
+// SPDX-FileCopyrightText: 2026 Erich Seifert <dev@erichseifert.de>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace ArdourPostProject {
+
+void record_source (const std::string& production_path, const std::string& source_id, const std::string& source_path);
+
+std::optional<std::string> resolve_missing_source (const std::string& production_path,
+                                                   const std::string& source_id,
+                                                   const std::vector<std::string>& search_directories);
+
+} // namespace ArdourPostProject
