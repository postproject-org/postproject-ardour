From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erich Seifert <dev@erichseifert.de>
Date: Thu, 1 Oct 2026 06:33:10 +0200
Subject: [PATCH 1/4] Accept exact missing-source replacements


diff --git a/libs/ardour/ardour/session.h b/libs/ardour/ardour/session.h
index 6aadc0518..ceaa3f904 100644
--- a/libs/ardour/ardour/session.h
+++ b/libs/ardour/ardour/session.h
@@ -1332,6 +1332,9 @@ public:
 	void set_missing_file_replacement (const std::string& mfr) {
 		_missing_file_replacement = mfr;
 	}
+	void set_missing_file_replacement_path (const std::string& path) {
+		_missing_file_replacement_path = path;
+	}
 
 	/** Emitted when the session wants Ardour to quit */
 	static PBD::Signal<void()> Quit;
@@ -1518,6 +1521,7 @@ private:
 	unsigned int            _xrun_count;
 
 	std::string             _missing_file_replacement;
+	std::string             _missing_file_replacement_path;
 
 	mutable std::atomic<int> _processing_prohibited;
 	mutable std::atomic<RecordState> _record_status;
@@ -2480,4 +2484,3 @@ private:
 
 
 } // namespace ARDOUR
-
diff --git a/libs/ardour/session_state.cc b/libs/ardour/session_state.cc
index e11f7d639..3c38b379b 100644
--- a/libs/ardour/session_state.cc
+++ b/libs/ardour/session_state.cc
@@ -3456,6 +3456,7 @@ retry:
 
 			int user_choice;
 			_missing_file_replacement = "";
+			_missing_file_replacement_path = "";
 
 			if (err.type == DataType::MIDI && Glib::path_is_absolute (err.path)) {
 				error << string_compose (_("An external MIDI file is missing. %1 cannot currently recover from missing external MIDI files"),
@@ -3475,7 +3476,15 @@ retry:
 					 * or selected a new absolute path,
 					 * so try again */
 					if (Glib::path_is_absolute (err.path)) {
-						if (!_missing_file_replacement.empty ()) {
+						if (!_missing_file_replacement_path.empty ()) {
+							/* An application resolver supplied an exact file. Unlike
+							 * the existing dialog result, its basename may differ. */
+							srcnode.set_property ("origin", _missing_file_replacement_path);
+							if (Glib::path_get_basename (err.path) == Glib::path_get_basename (_missing_file_replacement_path)) {
+								relocation[Glib::path_get_dirname (err.path)] = Glib::path_get_dirname (_missing_file_replacement_path);
+							}
+							_missing_file_replacement_path = "";
+						} else if (!_missing_file_replacement.empty ()) {
 							/* replace origin, in XML */
 							std::string newpath = Glib::build_filename (
 									_missing_file_replacement, Glib::path_get_basename (err.path));
