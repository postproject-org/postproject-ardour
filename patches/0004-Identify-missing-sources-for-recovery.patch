+	const auto asset_id = asset_for_source_id (production, source_id);
+	if (!asset_id) {
 		return std::nullopt;
 	}
+	const auto resource_id = single_audio_resource (production, *asset_id);
 
 	postproject::ResolutionOptions options;
 	std::vector<std::string> unique_directories;
@@ -98,10 +98,10 @@ resolve_missing_source (const std::string& production_path,
