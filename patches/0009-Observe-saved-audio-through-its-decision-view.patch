From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erich Seifert <dev@erichseifert.de>
Date: Wed, 7 Oct 2026 10:18:48 +0200
Subject: [PATCH] fix: observe saved audio through its retained decision view


diff --git a/gtk2_ardour/postproject_resolver.cc b/gtk2_ardour/postproject_resolver.cc
index bcee938c2..912f42415 100644
--- a/gtk2_ardour/postproject_resolver.cc
+++ b/gtk2_ardour/postproject_resolver.cc
@@ -19,19 +19,26 @@ void set_origin (postproject::Transaction& transaction, const std::string& messa
 	transaction.setRevisionContext ({{postproject::OriginIdentity {"org.ardour", std::nullopt, std::nullopt}}, message}).value ();
 }
 
-postproject::ResourceId single_audio_resource (const postproject::Production& production, const postproject::AssetId& asset_id)
+template <typename Reader>
+postproject::Resource single_audio_resource (const Reader& production, const postproject::AssetId& asset_id)
 {
-	for (const auto& representation : production.representations (asset_id).value ()) {
+	const auto page = production.representations (asset_id, 1000).value ();
+	if (page.next_cursor) {
+		throw postproject::Exception (postproject::Error (postproject::ErrorCode::unsupported,
+		                                               "audio representation decision exceeds 1000 entries"));
+	}
+	for (const auto& representation : page.items) {
 		if (representation.kind == postproject::RepresentationKind::original &&
 		    representation.structure_kind == postproject::ContentStructureKind::single_resource &&
 		    representation.resources.size () == 1) {
-			return representation.resources.front ().id;
+			return representation.resources.front ();
 		}
 	}
 	throw std::runtime_error ("PostProject asset has no single-file original representation");
 }
 
-std::optional<postproject::AssetId> asset_for_source_id (const postproject::Production& production, const std::string& source_id)
+template <typename Reader>
+std::optional<postproject::AssetId> asset_for_source_id (const Reader& production, const std::string& source_id)
 {
 	const auto matches = production.findByExternalIdentifier (source_id_scheme, source_id).value ();
 	if (matches.empty ()) {
@@ -51,26 +58,32 @@ void
 record_source (const std::string& production_path, const std::string& source_id, const std::string& source_path)
 {
 	auto production = postproject::Production::open (production_path).value ();
+	auto view = production.readSession ().value ();
 	const postproject::ExternalIdentifier identifier {std::string (source_id_scheme), source_id, std::nullopt};
-	const auto bound_asset = asset_for_source_id (production, source_id);
+	const auto bound_asset = asset_for_source_id (view, source_id);
 
 	if (bound_asset) {
-		const auto resource_id = single_audio_resource (production, *bound_asset);
-		auto transaction = production.beginTransaction ().value ();
+		const auto resource = single_audio_resource (view, *bound_asset);
+		const auto resource_id = resource.id;
+		auto transaction = view.edit ().value ();
 		set_origin (transaction, "Record Ardour audio source");
-		transaction.confirmLocator (resource_id, postproject::fileLocator (source_path).value ()).value ();
+		const auto uri = postproject::fileLocator (source_path).value ();
+		if (std::none_of (resource.locators.begin (), resource.locators.end (),
+		                  [&uri] (const auto& locator) { return locator.uri == uri; })) {
+			transaction.confirmLocator (resource_id, uri).value ();
+		}
 		transaction.observeResourceContent (resource_id, source_path).value ();
 		transaction.commit ().value ();
 		return;
 	}
 
 	const postproject::LocatorIdentity locator {postproject::fileLocator (source_path).value (), std::nullopt};
-	const auto known = production.findKnownMediaByLocator (locator, 2).value ();
+	const auto known = view.findKnownMediaByLocator (locator, 2).value ();
 	if (known.items.size () > 1) {
 		throw std::runtime_error ("audio source locator identifies several PostProject assets");
 	}
 
-	auto transaction = production.beginTransaction ().value ();
+	auto transaction = view.edit ().value ();
 	set_origin (transaction, "Record Ardour audio source");
 	postproject::AssetId asset_id = known.items.empty ()
 	                                ? transaction.importMedia (source_path, std::filesystem::path (source_path).filename ().string ()).value ()
@@ -89,7 +102,7 @@ resolve_missing_source (const std::string& production_path,
 	if (!asset_id) {
 		return std::nullopt;
 	}
-	const auto resource_id = single_audio_resource (production, *asset_id);
+	const auto resource_id = single_audio_resource (production, *asset_id).id;
 
 	auto options = postproject::ResolutionOptions::create().value();
 	std::vector<std::string> unique_directories;
